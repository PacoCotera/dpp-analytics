# Database / platform
POSTGRES_DB=dpp
POSTGRES_USER=dpp
POSTGRES_PASSWORD=CHANGE_ME
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
DPP_ADMIN_PASSWORD=CHANGE_ME_WITH_AT_LEAST_16_CHARACTERS
# Set true only when the board is served over HTTPS. Direct HTTP requires false.
DPP_ADMIN_COOKIE_SECURE=false
# Explicitly exposes password-protected Admin beyond loopback. This is unsafe on
# plain HTTP because credentials and cookies have no transport encryption.
DPP_ADMIN_ALLOW_REMOTE=false
TZ=America/Mexico_City

# Finance behavior
MX_VAT_RATE=0.16
FINANCE_ADS_CLOSE_GRACE_DAYS=10

# Selling Partner API
SPAPI_ENABLED=false
SPAPI_ENVIRONMENT=production
SPAPI_PRODUCTION_INGESTION_ENABLED=false
SPAPI_ENDPOINT=
SPAPI_MARKETPLACE_ID=A1AM78C64UM0Y8
SPAPI_LWA_CLIENT_ID=CHANGE_ME
SPAPI_LWA_CLIENT_SECRET=CHANGE_ME
SPAPI_LWA_REFRESH_TOKEN=CHANGE_ME

# Amazon Ads uses a separate authorization surface from SP-API.
AMAZON_ADS_ENABLED=false
AMAZON_ADS_CLIENT_ID=CHANGE_ME
AMAZON_ADS_CLIENT_SECRET=CHANGE_ME
AMAZON_ADS_REFRESH_TOKEN=CHANGE_ME
# Optional comma-separated Sponsored Ads profile IDs. Leave blank to use
# advertiser-account/profile discovery when the authorization exposes them.
AMAZON_ADS_ACCOUNT_IDS=
AMAZON_ADS_API_ENDPOINT=https://advertising-api.amazon.com
AMAZON_ADS_REPORTING_INTERVAL_SECONDS=21600
# Sponsored Products reporting is effectively limited to the latest 90 days.
AMAZON_ADS_BACKFILL_DAYS=90
AMAZON_ADS_REPORT_POLL_SECONDS=5
# Amazon Reporting v3 jobs can remain queued well beyond fifteen minutes.
AMAZON_ADS_REPORT_POLL_TIMEOUT_SECONDS=3600

# Historical backfill boundaries
ORDERS_BACKFILL_START=2025-10-01T00:00:00Z
FINANCES_BACKFILL_START=2025-10-01T00:00:00Z
DATA_KIOSK_BACKFILL_START=2025-10-01

# Steady-state ingestion cadence
# Orders is intentionally near-real-time for the Today workspace.
ORDERS_INTERVAL_SECONDS=180
INVENTORY_INTERVAL_SECONDS=1800
FINANCES_INTERVAL_SECONDS=14400
SETTLEMENT_REPORTS_INTERVAL_SECONDS=21600
DATA_KIOSK_INTERVAL_SECONDS=43200
LISTINGS_REPORT_INTERVAL_SECONDS=21600
CATALOG_ENABLED=true
CATALOG_INTERVAL_SECONDS=86400

# Async report / query polling
REPORTS_POLL_SECONDS=5
REPORTS_POLL_TIMEOUT_SECONDS=300
DATA_KIOSK_POLL_SECONDS=10
DATA_KIOSK_POLL_TIMEOUT_SECONDS=300

# Authorization/worker housekeeping
SANDBOX_PROBE_INTERVAL_SECONDS=21600
PRODUCTION_PROBE_INTERVAL_SECONDS=21600
SCHEDULER_TICK_SECONDS=15
