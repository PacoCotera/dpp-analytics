      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE job_name\n WHEN 'orders_v2026' THEN 'Orders'\n WHEN 'fba_inventory_v1' THEN 'FBA Inventory'\n WHEN 'finances_v2024' THEN 'Finances'\n WHEN 'sales_traffic_2024_04_24' THEN 'Sales & Traffic'\n ELSE job_name END AS \"Feed\",\n latest_status AS \"Status\",\n records_written AS \"Rows\",\n CASE WHEN age < interval '1 minute' THEN '<1m'\n      WHEN age < interval '1 hour' THEN floor(extract(epoch from age)/60)::int || 'm'\n      ELSE round(extract(epoch from age)/3600,1)::text || 'h' END AS \"Freshness\"\nFROM ops.data_health ORDER BY last_started_at DESC;"
        }
      ]
    }
