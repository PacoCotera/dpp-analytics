          "rawSql": "WITH d AS (SELECT max(business_date) AS d FROM mart.business_daily WHERE marketplace_id='A1AM78C64UM0Y8' AND reconciled_daily_report),\nx AS (SELECT business_date,sales_t28 FROM mart.business_rolling,d WHERE marketplace_id='A1AM78C64UM0Y8' AND business_date IN (d.d,d.d-28))\nSELECT CASE WHEN MAX(sales_t28) FILTER (WHERE business_date=(SELECT d FROM d)-28)>0 THEN\n100.0*(MAX(sales_t28) FILTER (WHERE business_date=(SELECT d FROM d))-MAX(sales_t28) FILTER (WHERE business_date=(SELECT d FROM d)-28))\n/(MAX(sales_t28) FILTER (WHERE business_date=(SELECT d FROM d)-28)) END AS value FROM x;"
