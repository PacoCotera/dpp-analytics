          "rawQuery": true,
          "rawSql": "SELECT sales_today AS \"Sales\", orders_today AS \"Orders\", units_today AS \"Units\", pace_vs_same_weekday_pct AS \"Pace\" FROM mart.today_operating WHERE marketplace_id='A1AM78C64UM0Y8';"
