          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE action IN ('STOCKOUT','PRODUCE','PLAN'))::int AS \"Needs Action\", count(*) FILTER (WHERE action='STOCKOUT')::int AS \"Stockouts\" FROM mart.inventory_attention WHERE marketplace_id='A1AM78C64UM0Y8';"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "SALES RHYTHM · 90 DAYS",
      "gridPos": {"x": 0, "y": 7, "w": 15, "h": 9},
      "datasource": {"type": "postgres", "uid": "dpp-postgres"},
      "fieldConfig": {
        "defaults": {
          "unit": "prefix:$",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {"mode": "palette-classic"}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Daily"},
            "properties": [
              {"id": "custom.drawStyle", "value": "bars"},
              {"id": "custom.lineWidth", "value": 0},
              {"id": "custom.fillOpacity", "value": 24},
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "#C98A35"}}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "7D avg"},
            "properties": [
              {"id": "custom.drawStyle", "value": "line"},
              {"id": "custom.lineWidth", "value": 3},
              {"id": "custom.fillOpacity", "value": 0},
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "#F1EEE8"}}
            ]
          }
        ]
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT business_date::timestamp AS time, sales AS \"Daily\", avg(sales) OVER (ORDER BY business_date ROWS BETWEEN 6 PRECEDING AND CURRENT ROW) AS \"7D avg\" FROM mart.business_daily WHERE marketplace_id='A1AM78C64UM0Y8' AND business_date>=CURRENT_DATE-89 ORDER BY 1;"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "CATALOG · MOVERS",
      "gridPos": {"x": 15, "y": 7, "w": 9, "h": 9},
      "datasource": {"type": "postgres", "uid": "dpp-postgres"},
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "T28 Sales"},
            "properties": [{"id": "unit", "value": "prefix:$"}, {"id": "decimals", "value": 0}]
          },
          {
            "matcher": {"id": "byName", "options": "Δ28"},
            "properties": [
              {"id": "unit", "value": "percent"},
              {"id": "decimals", "value": 0},
              {"id": "color", "value": {"mode": "thresholds"}},
              {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0}]}}
            ]
          }
        ]
      },
      "options": {"showHeader": true, "cellHeight": "sm"},
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT m.seller_sku AS \"SKU\", COALESCE(k.title,'') AS \"Product\", m.sales_t28 AS \"T28 Sales\", m.delta28_pct AS \"Δ28\", m.units_t28 AS \"Units\", m.state AS \"State\", COALESCE(i.available,0) AS \"FBA\" FROM mart.catalog_movers_t28 m LEFT JOIN core.sku k ON k.sku=m.seller_sku LEFT JOIN mart.inventory_attention i ON i.marketplace_id=m.marketplace_id AND i.seller_sku=m.seller_sku WHERE m.marketplace_id='A1AM78C64UM0Y8' AND m.sales_t28>0 ORDER BY m.sales_t28 DESC LIMIT 7;"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "INVENTORY · WHAT NEEDS ATTENTION",
      "gridPos": {"x": 0, "y": 16, "w": 24, "h": 6},
      "datasource": {"type": "postgres", "uid": "dpp-postgres"},
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Action"},
            "properties": [
              {"id": "custom.cellOptions", "value": {"type": "color-background"}},
              {"id": "mappings", "value": [
                {"type": "value", "options": {
                  "STOCKOUT": {"color": "red", "index": 0},
                  "PRODUCE": {"color": "orange", "index": 1},
                  "PLAN": {"color": "yellow", "index": 2}
                }}
              ]}
            ]
          }
        ]
      },
      "options": {"showHeader": true, "cellHeight": "sm"},
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT i.seller_sku AS \"SKU\", COALESCE(k.title,'') AS \"Product\", i.available AS \"Available\", i.inbound AS \"Inbound\", i.units_t28 AS \"T28 Units\", i.days_cover_on_hand AS \"Days Cover\", i.action AS \"Action\" FROM mart.inventory_attention i LEFT JOIN core.sku k ON k.sku=i.seller_sku WHERE i.marketplace_id='A1AM78C64UM0Y8' AND i.action IN ('STOCKOUT','PRODUCE','PLAN') ORDER BY CASE i.action WHEN 'STOCKOUT' THEN 0 WHEN 'PRODUCE' THEN 1 ELSE 2 END, i.days_cover_on_hand NULLS FIRST;"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "PIPELINE · FRESHNESS",
      "gridPos": {"x": 0, "y": 22, "w": 24, "h": 3},
      "datasource": {"type": "postgres", "uid": "dpp-postgres"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "fixed", "fixedColor": "#8F948E"}},
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto",
        "wideLayout": true,
        "text": {"titleSize": 10, "valueSize": 14}
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT max(CASE WHEN job_name='orders_v2026' THEN CASE WHEN latest_status='success' THEN '● ' ELSE '▲ ' END || CASE WHEN age<interval '1 minute' THEN '<1m' ELSE floor(extract(epoch from age)/60)::int::text||'m' END END) AS \"Orders\", max(CASE WHEN job_name='sales_traffic_2024_04_24' THEN CASE WHEN latest_status='success' THEN '● ' ELSE '▲ ' END || floor(extract(epoch from age)/60)::int::text||'m' END) AS \"Sales & Traffic\", max(CASE WHEN job_name='finances_v2024' THEN CASE WHEN latest_status='success' THEN '● ' ELSE '▲ ' END || floor(extract(epoch from age)/60)::int::text||'m' END) AS \"Finances\", max(CASE WHEN job_name='fba_inventory_v1' THEN CASE WHEN latest_status='success' THEN '● ' ELSE '▲ ' END || floor(extract(epoch from age)/60)::int::text||'m' END) AS \"FBA Inventory\" FROM ops.data_health;"
        }
      ]
    }
  ]
