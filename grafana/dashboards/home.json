    {
      "id": 11,
      "type": "table",
      "title": "INVENTORY \u00b7 WHAT NEEDS ATTENTION",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 15,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "dpp-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Action"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "STOCKOUT": {
                        "color": "red",
                        "index": 0
                      },
                      "PRODUCE": {
                        "color": "red",
                        "index": 1
                      },
                      "PLAN": {
                        "color": "orange",
                        "index": 2
                      },
                      "OK": {
                        "color": "green",
                        "index": 3
                      },
                      "HOLD": {
                        "color": "gray",
                        "index": 4
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH v AS (\n SELECT seller_sku, sum(units)::numeric/28 AS units_day\n FROM mart.sku_daily\n WHERE marketplace_id='A1AM78C64UM0Y8' AND business_date >= CURRENT_DATE-27\n GROUP BY seller_sku\n)\nSELECT i.seller_sku AS \"SKU\", COALESCE(k.title,'') AS \"Product\",\n       i.fulfillable_quantity AS \"Available\",\n       (i.inbound_working_quantity+i.inbound_shipped_quantity+i.inbound_receiving_quantity) AS \"Inbound\",\n       CASE WHEN COALESCE(v.units_day,0)>0 THEN round(i.fulfillable_quantity/v.units_day,1) END AS \"Days Cover\",\n       CASE WHEN i.fulfillable_quantity=0 AND COALESCE(v.units_day,0)>0 THEN 'STOCKOUT'\n            WHEN COALESCE(v.units_day,0)=0 THEN 'HOLD'\n            WHEN i.fulfillable_quantity/v.units_day < 14 THEN 'PRODUCE'\n            WHEN i.fulfillable_quantity/v.units_day < 28 THEN 'PLAN'\n            ELSE 'OK' END AS \"Action\"\nFROM mart.inventory_current i\nLEFT JOIN v USING (seller_sku)\nLEFT JOIN core.sku k ON k.sku=i.seller_sku\nWHERE i.marketplace_id='A1AM78C64UM0Y8'\nORDER BY CASE WHEN i.fulfillable_quantity=0 AND COALESCE(v.units_day,0)>0 THEN 0\n              WHEN COALESCE(v.units_day,0)>0 AND i.fulfillable_quantity/v.units_day<14 THEN 1\n              WHEN COALESCE(v.units_day,0)>0 AND i.fulfillable_quantity/v.units_day<28 THEN 2 ELSE 3 END,\n         \"Days Cover\" NULLS LAST LIMIT 10;"
        }
      ]
    },
