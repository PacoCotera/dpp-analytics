          "rawSql": "WITH x AS (\n  SELECT business_date, sales,\n         avg(sales) OVER (ORDER BY business_date ROWS BETWEEN 6 PRECEDING AND CURRENT ROW) AS sales_7d\n  FROM mart.business_daily\n  WHERE marketplace_id='A1AM78C64UM0Y8' AND business_date >= CURRENT_DATE-89\n)\nSELECT business_date::timestamp AS time, sales AS \"Daily\", sales_7d AS \"7d average\" FROM x ORDER BY 1;"
