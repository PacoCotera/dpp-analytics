      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH s AS (\n SELECT seller_sku, max(asin) asin, sum(sales) sales_t28, sum(units) units_t28\n FROM mart.sku_daily\n WHERE marketplace_id='A1AM78C64UM0Y8' AND business_date >= CURRENT_DATE-27\n GROUP BY seller_sku\n)\nSELECT s.seller_sku AS \"SKU\", COALESCE(k.title,'') AS \"Product\",\n       round(s.sales_t28,0) AS \"T28 Sales\", s.units_t28 AS \"Units\",\n       COALESCE(i.fulfillable_quantity,0) AS \"FBA\"\nFROM s LEFT JOIN core.sku k ON k.sku=s.seller_sku\nLEFT JOIN mart.inventory_current i ON i.marketplace_id='A1AM78C64UM0Y8' AND i.seller_sku=s.seller_sku\nORDER BY s.sales_t28 DESC NULLS LAST LIMIT 8;"
        }
      ]
