    {
      "id": 3,
      "type": "stat",
      "title": "28D · SALES",
      "gridPos": {"x": 9, "y": 3, "w": 5, "h": 4},
      "datasource": {"type": "postgres", "uid": "dpp-postgres"},
      "fieldConfig": {
        "defaults": {
          "unit": "prefix:$",
          "decimals": 0,
          "color": {"mode": "fixed", "fixedColor": "#F2EFE8"}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value",
        "wideLayout": false,
        "text": {"titleSize": 11, "valueSize": 34}
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH d AS (SELECT max(business_date) AS d FROM mart.business_daily WHERE marketplace_id='A1AM78C64UM0Y8' AND reconciled_daily_report) SELECT COALESCE(b.sales_t28,0) AS value FROM mart.business_rolling b JOIN d ON b.business_date=d.d WHERE b.marketplace_id='A1AM78C64UM0Y8';"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "28D · GROWTH",
      "gridPos": {"x": 14, "y": 3, "w": 5, "h": 4},
      "datasource": {"type": "postgres", "uid": "dpp-postgres"},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0}]}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value",
        "wideLayout": false,
        "text": {"titleSize": 11, "valueSize": 34}
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH d AS (SELECT max(business_date) AS d FROM mart.business_daily WHERE marketplace_id='A1AM78C64UM0Y8' AND reconciled_daily_report), x AS (SELECT business_date,sales_t28 FROM mart.business_rolling,d WHERE marketplace_id='A1AM78C64UM0Y8' AND business_date IN (d.d,d.d-28)) SELECT CASE WHEN MAX(sales_t28) FILTER (WHERE business_date=(SELECT d FROM d)-28)>0 THEN 100.0*(MAX(sales_t28) FILTER (WHERE business_date=(SELECT d FROM d))-MAX(sales_t28) FILTER (WHERE business_date=(SELECT d FROM d)-28))/(MAX(sales_t28) FILTER (WHERE business_date=(SELECT d FROM d)-28)) END AS value FROM x;"
        }
      ]
    },
    {
