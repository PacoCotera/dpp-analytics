{
  "name": "dpp-operating-board",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "npm run lint:contract && npm run lint:catalog-cache && npm run lint:js && npm run lint:css",
    "lint:contract": "node scripts/frontend-contract.mjs",
    "lint:catalog-cache": "node scripts/catalog-cache-contract.mjs",
    "lint:js": "eslint static/**/*.js --no-warn-ignored",
    "lint:css": "stylelint 'static/**/*.css'",
    "format:check": "prettier --check 'static/**/*.{css,html,js}'",
    "format": "prettier --write 'static/**/*.{css,html,js}'",
    "test:ads-assets": "node scripts/ads-chart-loader-contract.mjs",
    "test:formats": "node scripts/ui-format-contract.mjs",
    "quality": "npm run lint && npm run test:formats && npm run test:ads-assets && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "9.9.1",
    "eslint": "9.9.1",
    "globals": "15.9.0",
    "prettier": "3.3.3",
    "stylelint": "16.9.0",
    "stylelint-config-standard": "36.0.1"
  }
}
