{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DPP Analytics presentation profile registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "defaultProfileId",
    "storageKey",
    "paletteRevision",
    "paletteNote",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "defaultProfileId": {
      "const": "warm-studio"
    },
    "storageKey": {
      "const": "dpp.presentation.v1"
    },
    "paletteRevision": {
      "type": "string",
      "minLength": 1
    },
    "paletteNote": {
      "type": "string",
      "minLength": 1
    },
    "profiles": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "description",
          "paletteProvenance",
          "colorScheme",
          "themeColor",
          "shell",
          "profile",
          "density",
          "surfaceEmphasis",
          "typography",
          "geometry",
          "chartStyle",
          "effects",
          "tokens"
        ],
        "properties": {
          "id": {
            "enum": [
              "warm-studio",
              "midnight-saffron",
              "aubergine-aqua",
              "midnight-dark",
              "aubergine-dark",
              "weyland"
            ]
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "paletteProvenance": {
            "const": "implementation-defined"
          },
          "colorScheme": {
            "enum": [
              "light",
              "dark"
            ]
          },
          "themeColor": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "shell": {
            "const": "persistent-domain-sidebar"
          },
          "profile": {
            "enum": [
              "standard",
              "weyland"
            ]
          },
          "density": {
            "enum": [
              "comfortable",
              "compact"
            ]
          },
          "surfaceEmphasis": {
            "enum": [
              "quiet",
              "tinted",
              "expressive"
            ]
          },
          "typography": {
            "enum": [
              "humanist",
              "terminal"
            ]
          },
          "geometry": {
            "enum": [
              "soft",
              "precision"
            ]
          },
          "chartStyle": {
            "enum": [
              "solid",
              "outlined-vector"
            ]
          },
          "effects": {
            "enum": [
              "quiet",
              "instrument"
            ]
          },
          "tokens": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "canvas",
              "chrome",
              "header",
              "page",
              "surface",
              "surfaceSubtle",
              "surfaceRaised",
              "text",
              "textMuted",
              "textSubtle",
              "border",
              "borderStrong",
              "chromeText",
              "chromeMuted",
              "chromeBorder",
              "chromeActive",
              "chromeActiveText",
              "headerText",
              "headerMuted",
              "headerBorder",
              "interaction",
              "interactionHover",
              "interactionActive",
              "interactionText",
              "focusRing",
              "brand",
              "brandSoft",
              "brandText",
              "data1",
              "data2",
              "data3",
              "data4",
              "data5",
              "data6",
              "dataIncomplete",
              "dataGrid",
              "healthy",
              "healthySurface",
              "healthyText",
              "warning",
              "warningSurface",
              "warningText",
              "critical",
              "criticalSurface",
              "criticalText",
              "info",
              "infoSurface",
              "infoText",
              "fontBody",
              "fontDisplay",
              "fontDetail",
              "headingWeight",
              "kpiWeight",
              "bodySize",
              "metadataSize",
              "radiusSmall",
              "radiusMedium",
              "radiusLarge",
              "radiusPill",
              "borderWidth",
              "controlHeight",
              "shadowLow",
              "shadowHigh",
              "panelTexture",
              "motionDuration"
            ],
            "properties": {
              "canvas": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "chrome": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "header": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "page": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "surface": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "surfaceSubtle": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "surfaceRaised": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "text": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "textMuted": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "textSubtle": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "border": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "borderStrong": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "chromeText": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "chromeMuted": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "chromeBorder": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "chromeActive": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "chromeActiveText": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "headerText": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "headerMuted": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "headerBorder": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "interaction": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "interactionHover": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "interactionActive": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "interactionText": {
                "type": "string",
