              },
              "healthyText": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "warning": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "warningSurface": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "warningText": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
