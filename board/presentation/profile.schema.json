              "brandText": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "data1": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "data2": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "data3": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "data4": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "data5": {
                "type": "string",
